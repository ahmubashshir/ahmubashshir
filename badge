#!/bin/sh
fmt="$(
	cat   << 'EOF'

	<a style="text-decoration:none;display:inline-block;overflow:hidden;" rel="noreferrer" href="%s" target="_blank">
	<img alt="%s" src="https://ahmubashshir.github.io/assets/badges/%s.svg" style="height:28px;margin:0 1px 0!important">
	</a>
EOF
)"

printf "$fmt" "$2" "$1" "$1"
